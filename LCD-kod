#include "gd32vf103.h"
#include "drivers.h"
#include "lcd.h"

int main(void)
{
  float math;
  int display=0, input, key, state=0;
  int lookUpTbl[16]={1,4,7,14,2,5,8,0,3,6,9,15,10,11,12,13};

  t5omsi();                                                 // Initialize timer5 1kHz
  colinit();                                                // Initialize column toolbox
  l88init();                                                // Initialize 8*8 led toolbox
  keyinit();                                                // Initialize keyboard toolbox
  Lcd_SetType(LCD_INVERTED);                                // or use LCD_INVERTED!
  Lcd_Init();
  LCD_Clear(BLACK);
  LCD_ShowStr(8, 64, "0 % Compression", WHITE, TRANSPARENT);
  LCD_ShowStr(0,0, "Saline Solution", WHITE, TRANSPARENT);
  LCD_Fill(0,19,160,61,WHITE);

  while (1)
  {
    LCD_WR_Queue();
    if (t5expq())
    {
      l88row(colset());
      if ((key=keyscan())>0)
      {
        math=10*lookUpTbl[key];                             //Ändra till 10 medans Keyscan används
        math+=0.5;
        int value=math;
        LCD_Fill(0,64,160,80,BLACK);
        while(display!=value)
        {
          if(display<value)
          {
            LCD_Fill(display,20,display+1,60,RED);
            display++;
            if(display>160) display=160;
          }
          if(display>value)
          {
            LCD_Fill(display-1,20,display,60,WHITE);
            display--;
            if(display<0) display=0;
          }
          LCD_ShowStr(0,64,"Ajusting...",WHITE, TRANSPARENT);
        }
        LCD_Fill(0,64,160,80,BLACK);
        LCD_ShowStr(8, 64, "0 % Compression", WHITE, TRANSPARENT);
        LCD_ShowNum(0, 64, lookUpTbl[key]*6.25, 3, WHITE);        //6,25 gäller med Keyscan
      }
    }
  }
}
